---
import { siteContent } from "../content/site";

// The bare domain sends each visitor to their own language, so a link to it
// reaches every audience. Its card is the English page's card; a link meant
// for Japanese readers can point at /ja/, which carries its own.
const { title, description } = siteContent.en.meta;
const publicBase = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const publicSiteUrl = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, "");
const socialImage = publicSiteUrl
  ? `${publicSiteUrl}/og-ischca-grimoire.webp`
  : `${publicBase}og-ischca-grimoire.webp`;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="description" content={description} />
    <link rel="icon" href="./favicon.svg?v=1" type="image/svg+xml" />
    <link rel="icon" href="./favicon-32x32.png?v=1" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="./apple-touch-icon.png?v=1" sizes="180x180" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ischca" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="ja_JP" />
    {publicSiteUrl && <meta property="og:url" content={`${publicSiteUrl}/`} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="An aged vellum manuscript with a rust-red arcane sigil and the name Ischca" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta http-equiv="refresh" content="0;url=./ja/" />
    <title>{title}</title>
    <script is:inline>
      const locale = navigator.language.toLowerCase().startsWith("ja") ? "ja" : "en";
      window.location.replace(`./${locale}/`);
    </script>
  </head>
  <body>
    <p><a href="./ja/">日本語</a> / <a href="./en/">English</a></p>
  </body>
</html>
