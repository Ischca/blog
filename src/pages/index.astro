---
const title = "Ischca — Software Engineer";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="./favicon.svg?v=1" type="image/svg+xml" />
    <link rel="icon" href="./favicon-32x32.png?v=1" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="./apple-touch-icon.png?v=1" sizes="180x180" />
    <meta http-equiv="refresh" content="0;url=./ja/" />
    <title>{title}</title>
    <script is:inline>
      const locale = navigator.language.toLowerCase().startsWith("ja") ? "ja" : "en";
      window.location.replace(`./${locale}/`);
    </script>
  </head>
  <body>
    <p><a href="./ja/">日本語</a> / <a href="./en/">English</a></p>
  </body>
</html>
