---
import { CONTENT_UPDATED, SOCIAL_LINKS, siteContent, type Locale } from "../../content/site";
import "../../styles/global.css";

export function getStaticPaths() {
  return [
    { params: { lang: "ja" } },
    { params: { lang: "en" } },
  ];
}

const lang = Astro.params.lang as Locale;
const content = siteContent[lang];
const alternateLang: Locale = lang === "ja" ? "en" : "ja";
const publicBase = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const assetUrl = (path: string) => `${publicBase}${path.replace(/^\/+/, "")}`;
const pageUrl = (locale: Locale, page = "") => assetUrl(`${locale}/${page}`);
const publicSiteUrl = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, "");
const canonicalUrl = publicSiteUrl ? `${publicSiteUrl}/${lang}/profile/` : undefined;
const socialImage = publicSiteUrl
  ? `${publicSiteUrl}/og-ischca-grimoire.webp`
  : assetUrl("og-ischca-grimoire.webp");
const localeCode = lang === "ja" ? "ja_JP" : "en_US";
const alternateLocaleCode = lang === "ja" ? "en_US" : "ja_JP";
const external = { target: "_blank", rel: "noopener noreferrer" };

const sections = [
  { id: "products", label: content.navigation.products },
  { id: "skills", label: content.navigation.skills },
  { id: "selected-work", label: content.navigation.caseStudies },
  { id: "career", label: content.navigation.career },
  { id: "contact", label: content.navigation.contact },
];

const facts = [
  { label: content.hero.experienceLabel, value: content.hero.experienceValue },
  { label: content.hero.locationLabel, value: content.hero.locationValue },
  { label: content.hero.focusLabel, value: content.hero.focusValue },
  { label: content.hero.communicationLabel, value: content.hero.communicationValue },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  inLanguage: lang,
  dateModified: CONTENT_UPDATED,
  mainEntity: {
    "@type": "Person",
    name: "Ischca",
    jobTitle: lang === "ja" ? "ソフトウェアエンジニア" : "Software Engineer",
    homeLocation: { "@type": "Place", name: "Tokyo, Japan" },
    sameAs: SOCIAL_LINKS.map((link) => link.href),
    knowsAbout: content.skills.flatMap((group) => group.items),
    ...(publicSiteUrl ? { url: `${publicSiteUrl}/` } : {}),
  },
};
---

<html lang={lang} class={`profile-root profile-root--${lang}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{content.meta.profileTitle}</title>
    <meta name="description" content={content.meta.profileDescription} />
    <meta name="author" content="Ischca" />
    <meta name="robots" content="index,follow" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111113" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={assetUrl("favicon.svg?v=1")} type="image/svg+xml" />
    <link rel="icon" href={assetUrl("favicon-32x32.png?v=1")} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={assetUrl("apple-touch-icon.png?v=1")} sizes="180x180" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="alternate" hreflang={lang} href={pageUrl(lang, "profile/")} />
    <link rel="alternate" hreflang={alternateLang} href={pageUrl(alternateLang, "profile/")} />
    <link rel="alternate" hreflang="x-default" href={pageUrl("en", "profile/")} />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Ischca" />
    <meta property="og:title" content={content.meta.profileTitle} />
    <meta property="og:description" content={content.meta.profileDescription} />
    <meta property="og:locale" content={localeCode} />
    <meta property="og:locale:alternate" content={alternateLocaleCode} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={content.meta.profileTitle} />
    <meta name="twitter:description" content={content.meta.profileDescription} />
    <meta name="twitter:image" content={socialImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body class="profile">
    <a class="skip-link" href="#main">{lang === "ja" ? "本文へ移動" : "Skip to content"}</a>

    <header class="site-header">
      <div class="container site-header-inner">
        <a class="brand" href="#top">Ischca</a>
        <nav class="site-nav" aria-label={lang === "ja" ? "ページ内の項目" : "Sections"}>
          {sections.map((section) => <a href={`#${section.id}`}>{section.label}</a>)}
        </nav>
        <div class="site-tools">
          <a href={pageUrl(alternateLang, "profile/")} lang={alternateLang} hreflang={alternateLang}>{content.labels.language}</a>
          <a href={pageUrl(lang)}>{content.labels.viewGrimoire}</a>
        </div>
      </div>
    </header>

    <main id="main" class="container">
      <section id="top" class="hero" aria-labelledby="hero-title">
        <p class="eyebrow">{content.hero.eyebrow}</p>
        <h1 id="hero-title">Ischca</h1>
        <p class="hero-role">{content.hero.role}</p>
        <p class="hero-intro">{content.hero.introduction}</p>
        <dl class="facts">
          {facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>
        <ul class="buttons" aria-label={lang === "ja" ? "公開プロフィール" : "Public profiles"}>
          {SOCIAL_LINKS.map((link) => (
            <li><a href={link.href} {...external}>{link.label}</a></li>
          ))}
        </ul>
      </section>

      <section id="products" class="section" aria-labelledby="products-title">
        <header class="section-head">
          <p class="eyebrow">{content.sections.productsKicker}</p>
          <h2 id="products-title">{content.sections.productsTitle}</h2>
        </header>
        <div class="product-grid">
          {content.products.map((product, index) => (
            <article id={product.id} class="product" aria-labelledby={`${product.id}-name`}>
              <a class="product-media" href={product.links[0].href} {...external}>
                <img
                  src={assetUrl(product.image.src)}
                  alt={product.image.alt}
                  width={product.image.width}
                  height={product.image.height}
                  loading={index < 2 ? "eager" : "lazy"}
                  decoding="async"
                />
              </a>
              <div class="product-body">
              <div class="product-head">
                <h3 id={`${product.id}-name`}>{product.name}</h3>
                <span class="status">{product.status}</span>
              </div>
              <p class="product-kind">{product.kind}</p>
              <p class="product-tagline">{product.tagline}</p>
              <ul class="points">
                {product.highlights.map((highlight) => <li>{highlight}</li>)}
              </ul>
              <p class="product-role"><span class="label">{content.labels.role}</span>{product.role}</p>
              <ul class="chips" aria-label={content.labels.stack}>
                {product.stack.map((item) => <li>{item}</li>)}
              </ul>
              <p class="product-links">
                {product.links.map((link) => (
                  <a href={link.href} {...external}>{link.label}<span aria-hidden="true"> ↗</span></a>
                ))}
              </p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="skills" class="section" aria-labelledby="skills-title">
        <header class="section-head">
          <p class="eyebrow">{content.sections.skillsKicker}</p>
          <h2 id="skills-title">{content.sections.skillsTitle}</h2>
        </header>
        <div class="skill-grid">
          {content.skills.map((group) => (
            <article class="skill">
              <h3>{group.area}</h3>
              <ul class="chips">
                {group.items.map((item) => <li>{item}</li>)}
              </ul>
              <p class="skill-evidence"><span class="label">{content.labels.evidence}</span>{group.evidence}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="selected-work" class="section" aria-labelledby="selected-work-title">
        <header class="section-head">
          <p class="eyebrow">{content.sections.caseStudiesKicker}</p>
          <h2 id="selected-work-title">{content.sections.caseStudiesTitle}</h2>
        </header>
        <div class="rows">
          {content.caseStudies.map((study) => (
            <article class="row">
              <div class="row-meta">
                <p class="row-org">{study.organization}</p>
                {study.period && <p class="row-period">{study.period}</p>}
                <p class="row-role">{study.role}</p>
              </div>
              <div class="row-body">
                <h3>{study.title}</h3>
                <p>{study.summary}</p>
                <ul class="points">
                  {study.highlights.map((highlight) => <li>{highlight}</li>)}
                </ul>
                <ul class="chips" aria-label={content.labels.stack}>
                  {study.stack.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="career" class="section" aria-labelledby="career-title">
        <header class="section-head">
          <p class="eyebrow">{content.sections.careerKicker}</p>
          <h2 id="career-title">{content.sections.careerTitle}</h2>
        </header>
        <ol class="rows">
          {content.career.map((item) => (
            <li class="row">
              <div class="row-meta">
                <p class="row-period">{item.period}</p>
              </div>
              <div class="row-body">
                <h3>
                  {item.company}
                  {item.project && <span class="tag">{content.labels.project}</span>}
                </h3>
                <p class="row-role">{item.role}</p>
                <p>{item.summary}</p>
                <ul class="points">
                  {item.details.map((detail) => <li>{detail}</li>)}
                </ul>
                <p class="row-stack">{item.stack}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section id="contact" class="section" aria-labelledby="contact-title">
        <header class="section-head">
          <p class="eyebrow">{content.sections.contactKicker}</p>
          <h2 id="contact-title">{content.sections.contactTitle}</h2>
        </header>
        <div class="contact">
          <div class="contact-main">
            <p>{content.hero.availability}</p>
            <p>{content.sections.contactIntro}</p>
            <ul class="buttons">
              {SOCIAL_LINKS.map((link) => (
                <li><a href={link.href} {...external}>{link.label}</a></li>
              ))}
            </ul>
          </div>
          <div class="services">
            <h3>{content.sections.workTitle}</h3>
            <dl>
              {content.work.map((item) => (
                <div>
                  <dt>{item.title}</dt>
                  <dd>{item.summary}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container site-footer-inner">
        <p>© {CONTENT_UPDATED.slice(0, 4)} Ischca</p>
        <p>{content.labels.updated}: <time datetime={CONTENT_UPDATED}>{CONTENT_UPDATED}</time></p>
        <p><a href={pageUrl(lang)}>{content.labels.viewGrimoire}</a></p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  html.profile-root {
    --bg: #fafaf9;
    --surface: #ffffff;
    --text: #1c1b1f;
    --muted: #57565e;
    --faint: #85848c;
    --border: #e5e4e0;
    --accent: #a9432c;
    --accent-soft: rgba(169, 67, 44, 0.09);
    --chip: #f1f0ec;
    --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
    color-scheme: light;
    background: var(--bg);
    scroll-behavior: smooth;
    scroll-padding-top: 76px;
  }
  html.profile-root--ja {
    --font-sans: -apple-system, BlinkMacSystemFont, "Hiragino Sans", "Hiragino Kaku Gothic ProN", "Noto Sans JP", "Yu Gothic UI", "Yu Gothic", Meiryo, sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    html.profile-root {
      --bg: #111113;
      --surface: #18181b;
      --text: #ececee;
      --muted: #a9a8b0;
      --faint: #7f7e87;
      --border: #2a2a2f;
      --accent: #e8866b;
      --accent-soft: rgba(232, 134, 107, 0.12);
      --chip: #232328;
      color-scheme: dark;
    }
  }

  .profile {
    margin: 0;
    color: var(--text);
    background: var(--bg);
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  .profile-root--ja .profile {
    line-height: 1.85;
    letter-spacing: 0.02em;
    line-break: strict;
    /* Break between phrases, not inside words such as 改善, where the browser
       supports it; others keep the default character breaks. */
    word-break: auto-phrase;
    overflow-wrap: anywhere;
  }
  .profile a {
    color: inherit;
  }
  .profile a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }
  .profile ::selection {
    background: var(--accent-soft);
  }
  .profile h1,
  .profile h2,
  .profile h3 {
    margin: 0;
    line-height: 1.3;
    letter-spacing: 0;
  }
  .profile p {
    margin: 0;
  }

  .container {
    width: 100%;
    max-width: 1040px;
    margin: 0 auto;
    padding-inline: 24px;
    box-sizing: border-box;
  }

  .skip-link {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 20;
    padding: 8px 14px;
    border-radius: 8px;
    color: var(--text);
    background: var(--surface);
  }
  .skip-link:focus {
    top: 12px;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
  }
  .site-header-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 60px;
  }
  .brand {
    flex: none;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-decoration: none;
  }
  .site-nav {
    display: flex;
    gap: 4px 20px;
    margin-inline: auto;
    font-size: 0.92rem;
  }
  .site-nav a,
  .site-tools a {
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .site-nav a:hover,
  .site-tools a:hover {
    color: var(--text);
  }
  .site-tools {
    display: flex;
    flex: none;
    gap: 16px;
    font-size: 0.88rem;
  }

  .eyebrow {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero {
    padding: clamp(48px, 9vw, 104px) 0 clamp(40px, 6vw, 64px);
    border-bottom: 1px solid var(--border);
  }
  .hero h1 {
    margin-top: 10px;
    font-size: clamp(2.6rem, 7vw, 3.75rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.05;
  }
  .hero-role {
    margin-top: 12px !important;
    color: var(--muted);
    font-size: 1.12rem;
    font-weight: 500;
  }
  .hero-intro {
    max-width: 40em;
    margin-top: 22px !important;
    font-size: 1.05rem;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, max-content));
    gap: 12px 40px;
    margin: 28px 0 0;
  }
  .facts dt {
    color: var(--faint);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .facts dd {
    margin: 2px 0 0;
    font-weight: 600;
  }
  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }
  .buttons a {
    display: inline-flex;
    align-items: center;
    padding: 7px 16px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 150ms ease, color 150ms ease;
  }
  .buttons a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .section {
    padding-top: clamp(56px, 8vw, 88px);
  }
  .section-head {
    margin-bottom: 28px;
  }
  .section-head h2 {
    margin-top: 6px;
    font-size: clamp(1.6rem, 3.4vw, 2rem);
    font-weight: 700;
  }

  .label {
    margin-right: 0.6em;
    color: var(--text);
    font-weight: 600;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }
  .chips li {
    padding: 2px 9px;
    border-radius: 6px;
    color: var(--muted);
    background: var(--chip);
    font-size: 0.8rem;
    line-height: 1.7;
    white-space: nowrap;
  }

  .points {
    margin: 12px 0 0;
    padding-left: 1.2em;
    color: var(--muted);
  }
  .points li {
    margin: 4px 0;
    padding-left: 0.15em;
  }
  .points li::marker {
    color: var(--accent);
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .product {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    scroll-margin-top: 84px;
  }
  .product-media {
    position: relative;
    display: block;
    flex: none;
    aspect-ratio: 1200 / 630;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: var(--chip);
  }
  /* Absolutely placed so the picture's own 630px height never becomes the
     flex item's minimum height; the frame is sized by its ratio alone. */
  .product-media img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 320ms ease;
  }
  .product-media:hover img {
    transform: scale(1.025);
  }
  .product-media:focus-visible {
    outline-offset: -3px;
  }
  .product-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 22px 24px 24px;
  }
  .product-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 12px;
  }
  .product h3 {
    font-size: 1.4rem;
    font-weight: 700;
  }
  .status {
    padding: 3px 9px;
    border-radius: 999px;
    color: var(--accent);
    background: var(--accent-soft);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0;
    white-space: nowrap;
  }
  .product-kind {
    margin-top: 2px !important;
    color: var(--faint);
    font-size: 0.86rem;
  }
  .product-tagline {
    margin-top: 14px !important;
  }
  .product-role {
    margin-top: 14px !important;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .product-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin-top: auto !important;
    padding-top: 18px;
    font-size: 0.92rem;
    font-weight: 600;
  }
  .product-links a,
  .site-footer a {
    color: var(--accent);
    text-decoration: none;
  }
  .product-links a:hover,
  .site-footer a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .skill-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr));
    gap: 28px 36px;
  }
  .skill {
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }
  .skill h3 {
    font-size: 1.05rem;
    font-weight: 700;
  }
  .skill .chips {
    margin-top: 10px;
  }
  .skill-evidence {
    margin-top: 12px !important;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(170px, 0.3fr) 1fr;
    gap: 8px 40px;
    padding: 26px 0;
    border-top: 1px solid var(--border);
  }
  .row-meta p + p {
    margin-top: 2px;
  }
  .row-org {
    font-size: 1.05rem;
    font-weight: 700;
  }
  .row-period {
    color: var(--faint);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }
  .row-role {
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .row-body h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    font-size: 1.12rem;
    font-weight: 700;
  }
  .row-body h3 + p,
  .row-body .row-role + p {
    margin-top: 6px;
  }
  .row-body .row-role {
    margin-top: 2px;
  }
  .row-stack {
    margin-top: 12px !important;
    color: var(--faint);
    font-size: 0.86rem;
  }
  .tag {
    padding: 1px 8px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px;
  }
